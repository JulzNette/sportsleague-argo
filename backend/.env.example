# Copy this file to .env and adjust values for your machine.
DATABASE_URL=postgresql+psycopg2://sportsleague_user:sportsleague_pass@localhost:5432/sportsleague_db
# Generate a strong random secret, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
ENVIRONMENT=local
# JSON array of browser origins allowed to call the API.
# On Render set CORS_ORIGINS=["https://your-frontend.vercel.app"]
CORS_ORIGINS=["http://localhost:5173", "http://localhost:8020"]
