# Copy to .env and adjust.
# Local dev: use http://localhost:8020/api/v1
# Vercel production: set this to your Render backend URL, e.g.
#   VITE_API_BASE_URL=https://sportsleague-api.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:8020/api/v1

# EmailJS (emails sent from the browser: the registration-fee reminder and the
# sign-up verification code). Free account at https://emailjs.com - add an
# email service and TWO templates, then fill in:
VITE_EMAILJS_SERVICE_ID=service_6zh0c7n
VITE_EMAILJS_PUBLIC_KEY=UYVOvfUlIE-yUdJR1
# Fee reminder template (To Email should be {{to_email}}).
VITE_EMAILJS_TEMPLATE_ID_FEE=your_fee_template_id
# Sign-up verification code template. Variables the template needs:
#   {{to_email}}          -> the address the user typed at registration
#   {{verification_code}} -> the 6-digit code to finish sign-up
VITE_EMAILJS_TEMPLATE_ID_VERIFY=your_verify_template_id
