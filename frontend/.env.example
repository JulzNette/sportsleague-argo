# Copy to .env and adjust.
# Local dev: use http://localhost:8020/api/v1
# Vercel production: set this to your Render backend URL, e.g.
#   VITE_API_BASE_URL=https://sportsleague-api.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:8020/api/v1

# EmailJS (sends emails directly from the browser - no SMTP/domain needed).
# Create a free account at https://emailjs.com, add an email service, and make
# one template per message type below. Fill each Template ID in.
VITE_EMAILJS_SERVICE_ID=service_6zh0c7n
VITE_EMAILJS_PUBLIC_KEY=UYVOvfUlIE-yUdJR1

# Registration received - wait for approval (on submit).
VITE_EMAILJS_TEMPLATE_ID_ACK=template_3eqr1vm
# Registration approved (admin clicks Approve).
VITE_EMAILJS_TEMPLATE_ID_APPROVED=your_approved_template_id
# Payment received (admin marks fee Paid).
VITE_EMAILJS_TEMPLATE_ID_PAYMENT=your_payment_template_id
# Payment required / fee reminder (admin clicks "Email registrant").
VITE_EMAILJS_TEMPLATE_ID_FEE=your_fee_template_id
